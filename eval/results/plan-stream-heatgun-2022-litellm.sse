data: {"case_id":"case_d2b24e452b42","disclaimer":"Not a ruling. Confirm with a licensed customs broker or a CBP binding ruling.","llm_provider":"litellm","model_ids":{"engine":"gemini-4-argon","router":"gemini-3.8-flash","verifier":"gemini-4-argon"},"plan":{"case_id":"case_d2b24e452b42","target":"Thailand","family":"motorised_tools_small_appliances","baseline":{"move":[],"description":"No change: keep the current setup","variant_facts":"The merchandise under consideration is a Kobalt 12.5-amp heat gun, model 5208257. It features two fan speeds and a variable temperature control dial and is rated at 1500 watts. The main components are a plastic molded housing that encompasses a heating element, motor-fan assembly, power switch and power cord. It delivers hot air for heat shrinking, stripping paint, bending plastic, drying and thawing. The Kobalt 12.5-amp heat gun, model 5208257 is assembled in Thailand using components sourced from Thailand and China.\n\nThe main housing, front cover and heating element are produced in Thailand. The electric motor, fan, motor support, printed circuit board assembly (PCBA), switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners are sourced from China. \n\nFinal assembly in Thailand: press fit the fan to the motor spindle and attach the fan cover; crimp plugs to the heating element wires, add heat shrink tubing, solder wires to the switch and plug the heating element into the switch and PCBA; fasten the PCBA to the main housing, assemble the temperature knob, connect the PCBA to the motor, add the back cover and motor support; secure the power cord, add the switch slider, close the housing with screws, test, label and pack.\n","prediction":{"origin_country":"Thailand","key_factors":["Heating element and main housing"],"decisive_step":"Production of the heating element and main housing combined with final assembly in Thailand","confidence":0.75,"reasoning":"A heat gun's primary function is generating and directing intense heat. The heating element, which imparts the essential character alongside the motor/fan, is manufactured in Thailand, as are the main housing and front cover. While the motor, fan, and PCBA are from China, the fabrication of the core heating component and housing in Thailand, combined with final electoral integration, soldering, and assembly in Thailand, substantially transforms the components into a finished heat gun of Thai origin.","cited_rulings":[],"precedents":["N335508","N340187","N342124","N348083","N351782"],"trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"engine-v1","input_tokens":2782,"output_tokens":197,"latency_ms":1030}},"duty_effect_per_year":0,"added_cost_per_year":0,"net_per_year":0,"shown":false},"current_origin":{"country":"China","ruling":"N328954"},"plans":[],"rejected":[{"move":[],"description":"No change: keep the current setup","variant_facts":"The merchandise under consideration is a Kobalt 12.5-amp heat gun, model 5208257. It features two fan speeds and a variable temperature control dial and is rated at 1500 watts. The main components are a plastic molded housing that encompasses a heating element, motor-fan assembly, power switch and power cord. It delivers hot air for heat shrinking, stripping paint, bending plastic, drying and thawing. The Kobalt 12.5-amp heat gun, model 5208257 is assembled in Thailand using components sourced from Thailand and China.\n\nThe main housing, front cover and heating element are produced in Thailand. The electric motor, fan, motor support, printed circuit board assembly (PCBA), switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners are sourced from China. \n\nFinal assembly in Thailand: press fit the fan to the motor spindle and attach the fan cover; crimp plugs to the heating element wires, add heat shrink tubing, solder wires to the switch and plug the heating element into the switch and PCBA; fasten the PCBA to the main housing, assemble the temperature knob, connect the PCBA to the motor, add the back cover and motor support; secure the power cord, add the switch slider, close the housing with screws, test, label and pack.\n","prediction":{"origin_country":"Thailand","key_factors":["Heating element and main housing"],"decisive_step":"Production of the heating element and main housing combined with final assembly in Thailand","confidence":0.75,"reasoning":"A heat gun's primary function is generating and directing intense heat. The heating element, which imparts the essential character alongside the motor/fan, is manufactured in Thailand, as are the main housing and front cover. While the motor, fan, and PCBA are from China, the fabrication of the core heating component and housing in Thailand, combined with final electoral integration, soldering, and assembly in Thailand, substantially transforms the components into a finished heat gun of Thai origin.","cited_rulings":[],"precedents":["N335508","N340187","N342124","N348083","N351782"],"trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"engine-v1","input_tokens":2782,"output_tokens":197,"latency_ms":1030}},"duty_effect_per_year":0,"added_cost_per_year":0,"net_per_year":0,"shown":false,"rejection_reason":"current setup: CBP held China (N328954); engine predicts Thailand","rejection_kind":"current_setup"},{"move":[{"group":"pcba","to_plant":"th"},{"group":"switch_cord_minor_parts","to_plant":"th"}],"description":"Make PCBA (SMT) and Switch, cord and minor parts in Thailand","variant_facts":"The merchandise under consideration is a Kobalt 12.5-amp heat gun, model 5208257. It features two fan speeds and a variable temperature control dial and is rated at 1500 watts. The main components are a plastic molded housing that encompasses a heating element, motor-fan assembly, power switch and power cord. It delivers hot air for heat shrinking, stripping paint, bending plastic, drying and thawing. The Kobalt 12.5-amp heat gun, model 5208257 is assembled in Thailand using components sourced from Thailand and China.\n\nThe main housing, front cover, heating element, printed circuit board assembly (PCBA), switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners are produced in Thailand. The electric motor, fan and motor support are sourced from China. \n\nIn Thailand, the printed circuit board assembly (PCBA) will be produced in-house: SMT placement and reflow of the printed circuit board assembly; test the PCBA.\n\nIn Thailand, the switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners will be produced in-house: make the switch, power cord, wiring, supports and fasteners.\n\nFinal assembly in Thailand: press fit the fan to the motor spindle and attach the fan cover; crimp plugs to the heating element wires, add heat shrink tubing, solder wires to the switch and plug the heating element into the switch and PCBA; fasten the PCBA to the main housing, assemble the temperature knob, connect the PCBA to the motor, add the back cover and motor support; secure the power cord, add the switch slider, close the housing with screws, test, label and pack.\n","prediction":{"origin_country":"Thailand","key_factors":["Heating element, PCBA, housing, and final assembly"],"decisive_step":"Manufacturing of the heating element, PCBA (via SMT), and housing, combined with final assembly in Thailand","confidence":0.95,"reasoning":"Similar to N345938, the majority of the components—including the critical heating element, PCBA (fabricated via SMT), switch, power cord, and housing—are manufactured in Thailand. Although the electric motor and fan are sourced from China, the substantive manufacturing of the heat-generating and control components alongside the comprehensive final assembly in Thailand substantially transforms the Chinese components into a new article of commerce.","cited_rulings":["N345938"],"precedents":["N340187","N342124","N345938","N348083","N351922"],"trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"engine-v1","input_tokens":2773,"output_tokens":193,"latency_ms":1260}},"verdict":{"precedent_supported":true,"supporting_ruling":"N347421","confidence":0.85,"reasoning":"In Variant A, CBP held origin was China (N328954) because although the housing and heating element were made in Thailand and final assembly occurred there, almost all other key functional and structural components (motor, fan, PCBA, switch, power cord, wiring, back cover, insulator) were sourced from China. In Variant B, Thailand manufactures the PCBA via SMT, as well as the switch, power cord, wiring, back cover, insulator, heating element, and housing, leaving only the motor, fan, and support from China. Producing virtually all components (including SMT PCBA and heating element) plus assembly in Thailand confers Thailand origin.","trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"verifier-v1+known-a","input_tokens":5486,"output_tokens":363,"latency_ms":0}},"duty_effect_per_year":500000,"added_cost_per_year":95000,"net_per_year":405000,"shown":false,"rejection_reason":"precedent-supported but verifier confidence 0.85 is below 0.95","rejection_kind":"below_confidence_bar"},{"move":[{"group":"motor_fan_assembly","to_plant":"th"}],"description":"Make Motor-fan assembly in Thailand","variant_facts":"The merchandise under consideration is a Kobalt 12.5-amp heat gun, model 5208257. It features two fan speeds and a variable temperature control dial and is rated at 1500 watts. The main components are a plastic molded housing that encompasses a heating element, motor-fan assembly, power switch and power cord. It delivers hot air for heat shrinking, stripping paint, bending plastic, drying and thawing. The Kobalt 12.5-amp heat gun, model 5208257 is assembled in Thailand using components sourced from Thailand and China.\n\nThe main housing, front cover, heating element, electric motor, fan and motor support are produced in Thailand. The printed circuit board assembly (PCBA), switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners are sourced from China. \n\nIn Thailand, the electric motor, fan and motor support will be produced in-house: stamp rotor laminations from silicon steel; stack laminations and wind the rotor; build the stator; assemble the motor; press-fit the fan to the motor spindle.\n\nFinal assembly in Thailand: press fit the fan to the motor spindle and attach the fan cover; crimp plugs to the heating element wires, add heat shrink tubing, solder wires to the switch and plug the heating element into the switch and PCBA; fasten the PCBA to the main housing, assemble the temperature knob, connect the PCBA to the motor, add the back cover and motor support; secure the power cord, add the switch slider, close the housing with screws, test, label and pack.\n","prediction":{"origin_country":"Thailand","key_factors":["Heating element, electric motor, and fan assembly"],"decisive_step":"Production of the heating element, electric motor (stamping, winding), and fan, plus final assembly in Thailand","confidence":0.95,"reasoning":"The core components that impart the essential character of a heat gun—the heating element, electric motor, and fan—are manufactured in Thailand (including complex motor stamping and winding). Additionally, the main housing is produced in Thailand, where all components are finally assembled into the finished heat gun. Consistent with N351782 and N348083, origin is conferred by the country producing the primary functional components (heating and motorized airflow mechanisms), which here is Thailand.","cited_rulings":["N348083","N351782"],"precedents":["N340187","N342124","N348083","N351782","N351922"],"trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"engine-v1","input_tokens":2788,"output_tokens":217,"latency_ms":1241}},"verdict":{"precedent_supported":true,"supporting_ruling":"H317645","confidence":0.75,"reasoning":"In Variant A (N328954), origin was China because although the heating element, housing, and final assembly were in Thailand, the other core functional components (electric motor, fan, and PCBA) were from China. In Variant B, full production of the electric motor (stamping laminations, winding rotor, building stator, assembling motor) and fan moves to Thailand. With both core functional subassemblies of a heat gun (the heating element and the motor-fan assembly), plus the housing and final assembly, now produced in Thailand, only the PCBA and minor parts remain Chinese, shifting the country of origin to Thailand.","trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"verifier-v1+known-a","input_tokens":5127,"output_tokens":370,"latency_ms":0}},"duty_effect_per_year":500000,"added_cost_per_year":120000,"net_per_year":380000,"shown":false,"rejection_reason":"precedent-supported but verifier confidence 0.75 is below 0.95","rejection_kind":"below_confidence_bar"},{"move":[{"group":"motor_fan_assembly","to_plant":"th"},{"group":"switch_cord_minor_parts","to_plant":"th"}],"description":"Make Motor-fan assembly and Switch, cord and minor parts in Thailand","variant_facts":"The merchandise under consideration is a Kobalt 12.5-amp heat gun, model 5208257. It features two fan speeds and a variable temperature control dial and is rated at 1500 watts. The main components are a plastic molded housing that encompasses a heating element, motor-fan assembly, power switch and power cord. It delivers hot air for heat shrinking, stripping paint, bending plastic, drying and thawing. The Kobalt 12.5-amp heat gun, model 5208257 is assembled in Thailand using components sourced from Thailand and China.\n\nThe main housing, front cover, heating element, electric motor, fan, motor support, switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners are produced in Thailand. The printed circuit board assembly (PCBA) are sourced from China. \n\nIn Thailand, the electric motor, fan and motor support will be produced in-house: stamp rotor laminations from silicon steel; stack laminations and wind the rotor; build the stator; assemble the motor; press-fit the fan to the motor spindle.\n\nIn Thailand, the switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners will be produced in-house: make the switch, power cord, wiring, supports and fasteners.\n\nFinal assembly in Thailand: press fit the fan to the motor spindle and attach the fan cover; crimp plugs to the heating element wires, add heat shrink tubing, solder wires to the switch and plug the heating element into the switch and PCBA; fasten the PCBA to the main housing, assemble the temperature knob, connect the PCBA to the motor, add the back cover and motor support; secure the power cord, add the switch slider, close the housing with screws, test, label and pack.\n","prediction":{"origin_country":"Thailand","key_factors":["Heating element, electric motor, and fan assembly"],"decisive_step":"Manufacturing of the electric motor, heating element, and fan, along with final assembly of the heat gun in Thailand","confidence":0.98,"reasoning":"Nearly all key functional components of the heat gun—specifically the heating element, electric motor (stamped, wound, and assembled from silicon steel), fan, switch, and housing—are manufactured in Thailand. Only the PCBA is sourced from China. Similar to N351782, where the manufacture of the motor and fan blades imparted the essential character, the production of the core heating and air-moving components and final assembly in Thailand substantially transform the Chinese PCBA into a new article of commerce.","cited_rulings":["N351782"],"precedents":["N340187","N342124","N348083","N351782","N351922"],"trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"engine-v1","input_tokens":2833,"output_tokens":232,"latency_ms":1047}},"verdict":{"precedent_supported":true,"supporting_ruling":"N325810","confidence":0.9,"reasoning":"In Variant A (N328954), the heat gun is of Chinese origin because the electric motor, fan, PCBA, switch, power cord, and other components are sourced from China, while only the housing, front cover, and heating element are produced in Thailand. In Variant B, virtually every component—including the electric motor (stamping rotor laminations, winding the rotor, building the stator, assembling), fan, switch, power cord, wiring, housing, and heating element—is manufactured in Thailand, leaving only the PCBA sourced from China. Under CBP precedent (e.g., N325810), producing the motor core and virtually all functional components in Thailand shifts origin to Thailand.","trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"verifier-v1+known-a","input_tokens":7496,"output_tokens":397,"latency_ms":0}},"duty_effect_per_year":500000,"added_cost_per_year":155000,"net_per_year":345000,"shown":false,"rejection_reason":"precedent-supported but verifier confidence 0.90 is below 0.95","rejection_kind":"below_confidence_bar"},{"move":[{"group":"motor_fan_assembly","to_plant":"th"},{"group":"pcba","to_plant":"th"}],"description":"Make Motor-fan assembly and PCBA (SMT) in Thailand","variant_facts":"The merchandise under consideration is a Kobalt 12.5-amp heat gun, model 5208257. It features two fan speeds and a variable temperature control dial and is rated at 1500 watts. The main components are a plastic molded housing that encompasses a heating element, motor-fan assembly, power switch and power cord. It delivers hot air for heat shrinking, stripping paint, bending plastic, drying and thawing. The Kobalt 12.5-amp heat gun, model 5208257 is assembled in Thailand using components sourced from Thailand and China.\n\nThe main housing, front cover, heating element, electric motor, fan, motor support and printed circuit board assembly (PCBA) are produced in Thailand. The switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners are sourced from China. \n\nIn Thailand, the electric motor, fan and motor support will be produced in-house: stamp rotor laminations from silicon steel; stack laminations and wind the rotor; build the stator; assemble the motor; press-fit the fan to the motor spindle.\n\nIn Thailand, the printed circuit board assembly (PCBA) will be produced in-house: SMT placement and reflow of the printed circuit board assembly; test the PCBA.\n\nFinal assembly in Thailand: press fit the fan to the motor spindle and attach the fan cover; crimp plugs to the heating element wires, add heat shrink tubing, solder wires to the switch and plug the heating element into the switch and PCBA; fasten the PCBA to the main housing, assemble the temperature knob, connect the PCBA to the motor, add the back cover and motor support; secure the power cord, add the switch slider, close the housing with screws, test, label and pack.\n","prediction":{"origin_country":"Thailand","key_factors":["Heating element, electric motor-fan assembly, and PCBA"],"decisive_step":"In-house manufacturing of the electric motor (stamping, winding), PCBA (SMT), heating element, and housing, plus final assembly in Thailand","confidence":0.98,"reasoning":"The components that impart the essential character of the heat gun—the heating element, electric motor, fan, PCBA, and main housing—are all manufactured in Thailand through substantial operations including silicon steel stamping, rotor winding, and SMT placement. As in N342124 and N345938, fabricating the core functional subassemblies and performing final assembly in Thailand substantially transforms the minor Chinese components (switch, cord, wiring, fasteners) into a new article of commerce of Thai origin.","cited_rulings":["N342124","N345938"],"precedents":["N340187","N342124","N345938","N348083","N351922"],"trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"engine-v1","input_tokens":2783,"output_tokens":241,"latency_ms":1319}},"verdict":{"precedent_supported":true,"supporting_ruling":"N347421","counter_ruling":"N345859","confidence":0.92,"reasoning":"In N347421 and N345859 (fan-forced electric heaters), CBP held that the heating element, electric motor, fan, and control components impart the essential identity and functionality of a hot-air appliance. In Variant A, the motor, fan, and PCBA are sourced from China, leaving China as the origin despite Thai heating element and housing production. In Variant B, manufacturing the electric motor (stamping laminations, winding rotor, building stator), fan, and PCBA (SMT placement and reflow) in Thailand—alongside the Thai heating element, main housing, and final assembly—means all essential functional components originate in Thailand, shifting origin to Thailand as in N347421.","trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"verifier-v1+known-a","input_tokens":12461,"output_tokens":736,"latency_ms":0}},"duty_effect_per_year":500000,"added_cost_per_year":180000,"net_per_year":320000,"shown":false,"rejection_reason":"precedent-supported but verifier confidence 0.92 is below 0.95","rejection_kind":"below_confidence_bar"},{"move":[{"group":"pcba","to_plant":"th"}],"description":"Make PCBA (SMT) in Thailand","variant_facts":"The merchandise under consideration is a Kobalt 12.5-amp heat gun, model 5208257. It features two fan speeds and a variable temperature control dial and is rated at 1500 watts. The main components are a plastic molded housing that encompasses a heating element, motor-fan assembly, power switch and power cord. It delivers hot air for heat shrinking, stripping paint, bending plastic, drying and thawing. The Kobalt 12.5-amp heat gun, model 5208257 is assembled in Thailand using components sourced from Thailand and China.\n\nThe main housing, front cover, heating element and printed circuit board assembly (PCBA) are produced in Thailand. The electric motor, fan, motor support, switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners are sourced from China. \n\nIn Thailand, the printed circuit board assembly (PCBA) will be produced in-house: SMT placement and reflow of the printed circuit board assembly; test the PCBA.\n\nFinal assembly in Thailand: press fit the fan to the motor spindle and attach the fan cover; crimp plugs to the heating element wires, add heat shrink tubing, solder wires to the switch and plug the heating element into the switch and PCBA; fasten the PCBA to the main housing, assemble the temperature knob, connect the PCBA to the motor, add the back cover and motor support; secure the power cord, add the switch slider, close the housing with screws, test, label and pack.\n","prediction":{"origin_country":"Thailand","key_factors":["Heating element and Printed Circuit Board Assembly (PCBA)"],"decisive_step":"Production of the heating element and PCBA (via SMT), combined with final assembly in Thailand","confidence":0.92,"reasoning":"Consistent with N345938 and N348083, the origin of an electro-thermal appliance is driven by its core functional components and complex manufacturing. Here, the heating element (which provides the primary heat-generating function), the PCBA (manufactured via SMT to control temperature and fan speed), and the main housing are all produced in Thailand. Combining these critical Thai-origin components with the Chinese motor and fan via soldering, wiring, and mechanical assembly in Thailand substantially transforms the parts into a heat gun of Thai origin.","cited_rulings":["N348083","N345938"],"precedents":["N340187","N342124","N345938","N348083","N351922"],"trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"engine-v1","input_tokens":2730,"output_tokens":229,"latency_ms":752}},"verdict":{"precedent_supported":false,"counter_ruling":"H309758","confidence":0.65,"reasoning":"In Variant A (N328954), CBP held the heat gun's origin is China despite the main housing, front cover, heating element, and final assembly being in Thailand, because the electric motor, fan, PCBA, switch, and other components come from China. Moving only the PCBA (SMT placement and reflow) to Thailand in Variant B leaves the Chinese electric motor, fan, motor support, switch, power cord, and other components unchanged. As examined in H309758 (comparing Scenario 1 vs. Scenario 2 for a heating tool where PCBA population shifts to the assembly country), shifting a control PCBA alone does not alter origin when core functional components remain Chinese.","trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"verifier-v1+known-a","input_tokens":9131,"output_tokens":474,"latency_ms":0}},"duty_effect_per_year":500000,"added_cost_per_year":60000,"net_per_year":440000,"shown":false,"rejection_reason":"no earlier ruling found where CBP held this kind of change decisive","rejection_kind":"no_supporting_precedent"},{"move":[{"group":"switch_cord_minor_parts","to_plant":"th"}],"description":"Make Switch, cord and minor parts in Thailand","variant_facts":"The merchandise under consideration is a Kobalt 12.5-amp heat gun, model 5208257. It features two fan speeds and a variable temperature control dial and is rated at 1500 watts. The main components are a plastic molded housing that encompasses a heating element, motor-fan assembly, power switch and power cord. It delivers hot air for heat shrinking, stripping paint, bending plastic, drying and thawing. The Kobalt 12.5-amp heat gun, model 5208257 is assembled in Thailand using components sourced from Thailand and China.\n\nThe main housing, front cover, heating element, switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners are produced in Thailand. The electric motor, fan, motor support and printed circuit board assembly (PCBA) are sourced from China. \n\nIn Thailand, the switch, power cord, wiring, knob, back cover and support ring, heat insulator and fasteners will be produced in-house: make the switch, power cord, wiring, supports and fasteners.\n\nFinal assembly in Thailand: press fit the fan to the motor spindle and attach the fan cover; crimp plugs to the heating element wires, add heat shrink tubing, solder wires to the switch and plug the heating element into the switch and PCBA; fasten the PCBA to the main housing, assemble the temperature knob, connect the PCBA to the motor, add the back cover and motor support; secure the power cord, add the switch slider, close the housing with screws, test, label and pack.\n","prediction":{"origin_country":"Thailand","key_factors":["Heating element and housing components"],"decisive_step":"Manufacturing of the heating element, housing, and electrical components, combined with final assembly in Thailand","confidence":0.9,"reasoning":"In Thailand, the critical heating element (which provides the core heat-generating function of a heat gun), the main housing, switch, and power cord are manufactured. Although the motor, fan, and PCBA are sourced from China, the production of the primary heating component and structural housing in Thailand, combined with final assembly, soldering, wiring, and testing in Thailand, constitutes a substantial transformation of the Chinese components into a new and different article of commerce.","cited_rulings":[],"precedents":["N335508","N340187","N342124","N348083","N351782"],"trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"engine-v1","input_tokens":2827,"output_tokens":186,"latency_ms":678}},"verdict":{"precedent_supported":false,"counter_ruling":"H317645","confidence":0.78,"reasoning":"In Variant A (N328954), CBP held the origin was China even though the main housing, front cover, and heating element were produced in Thailand and final assembly occurred there, because key functional components (electric motor, fan, motor support, PCBA) came from China and final assembly was simple. In Variant B, only minor auxiliary components (switch, power cord, wiring, knob, back cover, insulator, fasteners) shift from China to Thailand, while the core Chinese functional components (motor, fan, motor support, PCBA) and the simple assembly process remain unchanged. Under CBP precedent (e.g., H317645), shifting minor components without changing core assemblies does not alter origin.","trace":{"llm_provider":"litellm","model_id":"gemini-4-argon","prompt_version":"verifier-v1+known-a","input_tokens":7600,"output_tokens":401,"latency_ms":0}},"duty_effect_per_year":500000,"added_cost_per_year":35000,"net_per_year":465000,"shown":false,"rejection_reason":"no earlier ruling found where CBP held this kind of change decisive","rejection_kind":"no_supporting_precedent"}],"stats":{"moves_searched":6,"engine_calls":7,"verifier_runs":6,"verifier_model_calls":23,"verifier_tool_calls":36,"input_tokens":66817,"output_tokens":4236,"engine_input_tokens":19516,"engine_output_tokens":1495,"verifier_input_tokens":47301,"verifier_output_tokens":2741,"wall_seconds":27.990110666},"economics_illustrative":true,"duty_rates_note":"HTS 8419.89.95 (classification inferred, unverified for this model): MFN 4.2% + Section 301 List 2 25% (China) + Section 301 forced-labor 12.5% (both); IEEPA invalidated. Sources and caveats: docs/DUTY-SOURCES.md, checked 15 Oct 2026.","template_versions":{"motorised_tools_small_appliances":"1"}},"prompt_versions":{"answers":"answers-v2","clarify":"clarify-v1","engine":"engine-v1","router":"router-v2","verifier":"verifier-v1"}}

